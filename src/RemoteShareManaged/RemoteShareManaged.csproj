<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RemoteShareManaged</RootNamespace>
    <AssemblyName>RemoteShareManaged</AssemblyName>
    <!-- Pure managed — no platform constraints. Runs on Windows/Linux/Android -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CodecTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="xunit.extensibility.core" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NAudio">
      <HintPath>..\SCULAN10Remote\NAudio.dll</HintPath>
    </Reference>
  </ItemGroup>


</Project>
